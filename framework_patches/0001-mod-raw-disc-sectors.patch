+/* Consecutive raw 2352-byte sectors of the effective disc, Form 2 (XA)
+ * included, for mods that decode XA audio themselves. Committed sector mods
+ * apply. Images without raw sectors (.iso) fail. */
+extern "C" int psx_mod_read_disc_raw_sectors(uint32_t lba, uint32_t count,
+                                             void* buffer) {
+    using namespace PSXRecompV4;
+    if (!buffer || !count || count > 360000u || lba > 360000u - count) return 0;
+    try {
+        const auto& s = state();
+        const auto& mount = s.effective_disc_path.empty() ? s.disc_path : s.effective_disc_path;
+        if (mount.empty()) return 0;
+        PS1::ISOReader reader;
+        if (!reader.Open(mount.string())) return 0;
+        auto* out = static_cast<uint8_t*>(buffer);
+        for (uint32_t i = 0; i < count; ++i, out += 2352) {
+            if (!reader.ReadRawSector(lba + i, out)) return 0;
+            patch_committed_disc_sector(lba + i, 1, out, 2352);
+        }
+        return !s.disc_guard_failed;
+    } catch (...) { return 0; }
+}
